+.saisie-manette { width: min(660px, calc(100vw - 24px)); max-height: calc(100dvh - 24px); padding: 24px; border: 1px solid #637783; border-radius: 7px; background: #101a23; color: var(--papier); overflow: auto; touch-action: pan-y; box-shadow: 0 24px 100px #000b; }
+.saisie-manette::backdrop { background: #030608da; }
+.saisie-manette header { display: flex; align-items: center; justify-content: space-between; gap: 14px; }
+.saisie-manette h2 { margin: 0; font: 750 25px/1.2 var(--f-texte); }
+.saisie-manette button { min-height: 44px; border: 1px solid #415664; border-radius: 4px; background: #22313d; color: var(--papier); padding: 8px 12px; cursor: pointer; }
+.saisie-manette button:hover { background: #314957; }
+.saisie-manette button:focus { outline: 3px solid var(--ambre); outline-offset: 2px; }
+#sm-contenu { margin: 20px 0 6px; padding: 12px 16px; min-height: 55px; border: 1px solid #647583; border-radius: 3px; background: #080d12; font: 650 23px/1.2 var(--f-texte); letter-spacing: .08em; white-space: pre-wrap; overflow-wrap: anywhere; }
+#sm-contenu:empty::after { content: '…'; color: #6c7d89; }
+#sm-limite, .sm-aide { color: var(--papier-2); font-size: 12px; margin: 6px 0 18px; }
+#sm-touches { display: flex; flex-direction: column; gap: 8px; }
+.sm-ligne { display: flex; justify-content: center; gap: 7px; }
+.sm-ligne button { flex: 1 1 0; max-width: 50px; min-width: 0; padding: 6px 2px; }
+.sm-actions { display: flex; flex-wrap: wrap; gap: 8px; margin: 18px 0 12px; }
+.sm-actions button { flex: 1 1 auto; }
+#sm-valider { color: #fff4df; border-color: #e88e58; background: #8d3324; }
+#sm-maj[aria-pressed="true"] { border-color: #eab261; background: #694d22; }
+.sm-aide { margin-bottom: 0; }
+@media (max-width: 600px) {
+  .saisie-manette { padding: 14px; }
+  .saisie-manette h2 { font-size: 20px; }
+  .sm-ligne { gap: 4px; }
+  .sm-ligne button { min-height: 42px; }
+}
+@media (max-height: 500px) {
+  .saisie-manette { padding: 12px 18px; }
+  #sm-contenu { min-height: 40px; margin-top: 10px; padding: 7px 12px; }
+  #sm-limite { margin-bottom: 10px; }
+  .sm-ligne button { min-height: 36px; }
+  #sm-touches, .sm-ligne { gap: 5px; }
+  .sm-actions { margin: 10px 0 6px; }
+}
