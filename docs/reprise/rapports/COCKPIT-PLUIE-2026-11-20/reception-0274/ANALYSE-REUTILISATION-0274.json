    "modifications": [
      "hud-rivaux.bottom = calc(30% + 42px)",
      "hud-rivaux.gap = 0",
      "classement.gap = 0",
      "classement li.padding-block = 0",
      "regime.width = min(100%,12cqh)",
      "regime.justify-self = end"
    ]
  },
