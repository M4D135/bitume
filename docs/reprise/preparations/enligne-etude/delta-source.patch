+    const ds = [], dd = [];
+    releves.forEach((liste, i) => {
+      if (i === p) return;
+      for (const x of liste) {
+        const ref = releves[p].reduce((m, y) => Math.abs(y.h - x.h) < Math.abs(m.h - x.h) ? y : m, releves[p][0]);
