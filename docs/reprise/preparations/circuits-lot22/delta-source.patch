+      <h1>${f.nom} (${f.theme}) — vue ${vue === 'bord' ? 'bord de piste' : 'cockpit'}${etiquette ? ' — ' + etiquette : ''} <span>· tous les ${pas} m · ${nf(f.longueur)} m · ${qualite}, ${saison}, ${moment}</span></h1><div class="g">${cases}</div></html>`;
