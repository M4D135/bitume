+      // puis le niveau effectivement présent dans la liste de rendu sera observé indépendamment.
+      const h = J.rendu.gl.canvas.height, t = Math.tan(s.fov * Math.PI / 360), distances = [];
+      for (let d = 2; d <= 800; d += .5) {
