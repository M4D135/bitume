@@ -0,0 +1,94 @@
+name: Images habitacle commun et assise
+
+on:
+  push:
+    branches: ['codex/bitume-habitacle-0269-20261120']
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+concurrency:
+  group: visuel-habitacle-${{ github.ref }}
+  cancel-in-progress: true
+
+env:
+  REFERENCE_COMMIT: '3daefb7c9d7decaf77beb94219abcf16d907bb38'
+  REFERENCE_SHA256: '60184ddf5226543ca3f912cc9415927989f14e4e20de3556767ced801e988aa2'
+
+jobs:
+  images:
+    runs-on: ubuntu-latest
+    timeout-minutes: 35
+    strategy:
+      fail-fast: false
+      max-parallel: 3
+      matrix:
+        # Chaque groupe produit 2 PNG de référence et 6 du candidat :
+        # une vue neutre avant/après, puis deux scènes du seul candidat.
+        include:
+          - groupe: face-commandes
+            reference: face
+            cas: cockpit,braquage-passage
+          - groupe: profil-gestes
+            reference: profil
+            cas: geste-majeur,lod-moyen
+          - groupe: planche-portrait
+            reference: trois-quarts
+            cas: cockpit-portrait,lod-simple
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          ref: ${{ github.sha }}
+          persist-credentials: false
+          fetch-depth: 0
+      - uses: actions/setup-node@v4
+        with:
+          node-version: '24'
+      - name: Identifier les arbres et reconstruire le candidat exact
+        id: build
+        shell: bash
+        run: |
+          set -euo pipefail
+          mkdir -p qualification
+          git rev-parse HEAD > qualification/COMMIT.txt
+          git rev-parse 'HEAD^{tree}' > qualification/TREE.txt
+          test "$(cat qualification/COMMIT.txt)" = "$GITHUB_SHA"
+          git rev-parse "$REFERENCE_COMMIT" > qualification/REFERENCE_COMMIT.txt
+          git rev-parse "$REFERENCE_COMMIT^{tree}" > qualification/REFERENCE_TREE.txt
+          git show "$REFERENCE_COMMIT:VERSION.json" > qualification/REFERENCE_VERSION.json
+          git show "$REFERENCE_COMMIT:dist/bitume.html" > qualification/reference-0268.html
+          printf '%s  qualification/reference-0268.html\n' "$REFERENCE_SHA256" | sha256sum --check
+          node -e 'if (JSON.parse(require("node:fs").readFileSync("qualification/REFERENCE_VERSION.json", "utf8")).version !== "0.2.68") throw new Error("Référence différente de 0.2.68")'
+          google-chrome --version > qualification/ENVIRONNEMENT.txt
+          node --version >> qualification/ENVIRONNEMENT.txt
+          python3 --version >> qualification/ENVIRONNEMENT.txt
+          python3 construire.py 2>&1 | tee qualification/build.log
+          sha256sum dist/bitume.html qualification/reference-0268.html > qualification/SHA256SUMS.txt
+          git diff --exit-code -- VERSION.json SIZE.json dist/bitume.html
+      - name: Comparer la vue neutre avec la reference 0.2.68
+        shell: bash
+        run: |
+          node tools/captures-habitacle.mjs --url "file://$GITHUB_WORKSPACE/dist/bitume.html" --avant "file://$GITHUB_WORKSPACE/qualification/reference-0268.html" --sortie qualification/visuel-habitacle/comparaison --chrome /usr/bin/google-chrome --cas "${{ matrix.reference }}"
+      - name: Capturer les deux autres scenes du candidat reel
+        if: ${{ !cancelled() && steps.build.outcome == 'success' }}
+        shell: bash
+        run: |
+          node tools/captures-habitacle.mjs --url "file://$GITHUB_WORKSPACE/dist/bitume.html" --sortie qualification/visuel-habitacle/candidat --chrome /usr/bin/google-chrome --cas "${{ matrix.cas }}"
+      - name: Conserver les images et diagnostics meme en cas d'echec
+        if: always()
+        uses: actions/upload-artifact@v4
+        with:
+          name: bitume-habitacle-${{ matrix.groupe }}-${{ github.sha }}
+          path: |
+            qualification/visuel-habitacle/
+            qualification/COMMIT.txt
+            qualification/TREE.txt
+            qualification/REFERENCE_COMMIT.txt
+            qualification/REFERENCE_TREE.txt
+            qualification/REFERENCE_VERSION.json
+            qualification/SHA256SUMS.txt
+            qualification/ENVIRONNEMENT.txt
+            qualification/build.log
+          if-no-files-found: error
+          retention-days: 14
